rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Khóa tuyệt đối dữ liệu nhạy cảm & state gốc (chỉ server Admin SDK đọc/ghi)
    match /werewolf_server/{doc} {
      allow read, write: if false;
    }
    match /accounts/{username} {
      allow read, write: if false;
    }
    match /sessions/{token} {
      allow read, write: if false;
    }
    match /user_secrets/{uid} {
      allow read, write: if false;
    }
    match /dm_index/{pairKey} {
      allow read, write: if false;
    }

    // Mỗi người chỉ đọc đúng view / inbox / DM của mình theo token/key bí mật, cấm liệt kê
    match /werewolf_views/{token} {
      allow get: if true;
      allow list, write: if false;
    }
    match /voice_inbox/{token} {
      allow get: if true;
      allow list, write: if false;
    }
    match /user_inbox/{token} {
      allow get: if true;
      allow list, write: if false;
    }
    match /dm_threads/{dmSecretId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Dữ liệu công khai (hồ sơ, sảnh, chat chung, lịch sử ván) chỉ đọc; mọi thao tác ghi qua API
    match /user_profiles/{uid} {
      allow read: if true;
      allow write: if false;
    }
    match /hub/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /messages/{msgId} {
      allow read: if true;
      allow write: if false;
    }
    match /match_history/{matchId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
