rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Khóa tuyệt đối dữ liệu nhạy cảm & state gốc (chỉ server Admin SDK đọc/ghi)
    match /werewolf_server/{doc} {
      allow read, write: if false;
    }
    match /room_servers/{roomId} {
      allow read, write: if false;
    }
    match /room_codes/{code} {
      allow read, write: if false;
    }
    match /accounts/{username} {
      allow read, write: if false;
    }
    match /sessions/{token} {
      allow read, write: if false;
    }
    match /user_secrets/{uid} {
      allow read, write: if false;
    }
    match /dm_index/{pairKey} {
      allow read, write: if false;
    }

    // Dữ liệu tách biệt theo nhóm & theo token/key bí mật: chỉ cho get đúng doc, CẤM list & write
    match /rooms/{roomId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /room_hubs/{roomId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /room_chats/{roomId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /room_histories/{roomId} {
      allow get: if true;
      allow list, write: if false;
    }
    match /werewolf_views/{viewKey} {
      allow get: if true;
      allow list, write: if false;
    }
    match /voice_inbox/{token} {
      allow get: if true;
      allow list, write: if false;
    }
    match /user_inbox/{token} {
      allow get: if true;
      allow list, write: if false;
    }
    match /dm_threads/{dmSecretId} {
      allow get: if true;
      allow list, write: if false;
    }

    // Hồ sơ người dùng: chỉ cho get theo uid (cấm list để nhóm A không quét được thành viên nhóm B)
    match /user_profiles/{uid} {
      allow get: if true;
      allow list, write: if false;
    }

    // Dữ liệu cũ (legacy) khóa ghi
    match /hub/{doc} {
      allow read: if true;
      allow write: if false;
    }
    match /messages/{msgId} {
      allow read: if true;
      allow write: if false;
    }
    match /match_history/{matchId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
