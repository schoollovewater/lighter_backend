{
  "version": 2,
  "regions": ["sin1"],
  "cleanUrls": true,
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/public/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/gm/assets/(.*)",
      "destination": "/public/gm/assets/$1"
    },
    {
      "source": "/gm/(.*)",
      "destination": "/public/gm/$1"
    },
    {
      "source": "/gm",
      "destination": "/public/gm/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/public/$1"
    }
  ]
}
